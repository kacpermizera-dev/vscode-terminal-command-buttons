{
  "name": "terminal-command-buttons",
  "displayName": "Terminal Command Buttons",
  "description": "One-click buttons for your terminal commands, right next to the terminal: run status, variables, groups, stop/restart and git aliases.",
  "version": "1.0.0",
  "publisher": "kacpermizera-dev",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1e2128",
    "theme": "dark"
  },
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/kacpermizera-dev/vscode-terminal-command-buttons.git"
  },
  "bugs": {
    "url": "https://github.com/kacpermizera-dev/vscode-terminal-command-buttons/issues"
  },
  "homepage": "https://github.com/kacpermizera-dev/vscode-terminal-command-buttons#readme",
  "keywords": [
    "terminal",
    "commands",
    "buttons",
    "command runner",
    "shortcuts",
    "scripts",
    "npm scripts",
    "git",
    "git aliases",
    "status bar",
    "productivity",
    "automation"
  ],
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Command buttons from the project's .vscode/settings.json and repository git aliases are ignored until the workspace is trusted.",
      "restrictedConfigurations": [
        "terminalCommandButtons.buttons"
      ]
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "terminalCommandButtons.dockToTerminal",
        "title": "Show Buttons Next to Terminal",
        "category": "Terminal Command Buttons",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "terminalCommandButtons.openButtonsPanel",
        "title": "Open Terminal Command Buttons",
        "category": "Terminal Command Buttons"
      },
      {
        "command": "terminalCommandButtons.addButton",
        "title": "Add New Command Button",
        "category": "Terminal Command Buttons"
      },
      {
        "command": "terminalCommandButtons.toggleCollapseAll",
        "title": "Collapse / Expand All",
        "category": "Terminal Command Buttons",
        "icon": "$(collapse-all)"
      },
      {
        "command": "terminalCommandButtons.toggleLayout",
        "title": "Toggle Icons / List Layout",
        "category": "Terminal Command Buttons",
        "icon": "$(list-flat)"
      },
      {
        "command": "terminalCommandButtons.runPicker",
        "title": "Run Command Button…",
        "category": "Terminal Command Buttons",
        "icon": "$(play)"
      },
      {
        "command": "terminalCommandButtons.manageGitAliases",
        "title": "Git Aliases…",
        "category": "Terminal Command Buttons",
        "icon": "$(source-control)"
      },
      {
        "command": "terminalCommandButtons.rerunLast",
        "title": "Rerun Last Command",
        "category": "Terminal Command Buttons",
        "icon": "$(debug-rerun)",
        "enablement": "terminalCommandButtons.hasLast"
      },
      {
        "command": "terminalCommandButtons.runButton",
        "title": "Run",
        "category": "Terminal Command Buttons"
      },
      {
        "command": "terminalCommandButtons.moveWorkspaceButtons",
        "title": "Move Buttons from .vscode/settings.json into VS Code",
        "category": "Terminal Command Buttons"
      },
      {
        "command": "terminalCommandButtons.stopButton",
        "title": "Stop",
        "category": "Terminal Command Buttons"
      },
      {
        "command": "terminalCommandButtons.restartButton",
        "title": "Restart",
        "category": "Terminal Command Buttons"
      },
      {
        "command": "terminalCommandButtons.editButton",
        "title": "Edit Button",
        "category": "Terminal Command Buttons"
      },
      {
        "command": "terminalCommandButtons.deleteButton",
        "title": "Delete Button",
        "category": "Terminal Command Buttons"
      }
    ],
    "views": {
      "terminalCommandButtons": [
        {
          "type": "webview",
          "id": "terminalCommandButtons.buttonsView",
          "name": "Terminal Commands",
          "icon": "$(terminal)",
          "when": "true"
        }
      ],
      "terminalButtonsPanel": [
        {
          "type": "webview",
          "id": "terminalCommandButtons.panelView",
          "name": "Command Buttons",
          "icon": "$(play)"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "terminalCommandButtons",
          "title": "Terminal Command Buttons",
          "icon": "$(terminal)"
        }
      ],
      "panel": [
        {
          "id": "terminalButtonsPanel",
          "title": "Command Buttons",
          "icon": "$(play)"
        }
      ]
    },
    "configuration": {
      "title": "Terminal Command Buttons",
      "properties": {
        "terminalCommandButtons.buttons": {
          "type": "array",
          "default": [],
          "description": "Command buttons shown in every workspace. Buttons marked \"Only in this workspace\" are stored inside VS Code, not here and not in the project's files.",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique identifier for the button"
              },
              "name": {
                "type": "string",
                "description": "Display name for the button"
              },
              "command": {
                "type": "string",
                "description": "Command to execute"
              },
              "color": {
                "type": "string",
                "description": "Color for the button"
              },
              "icon": {
                "type": "string",
                "description": "Codicon name shown on the button, e.g. git-branch, play, sync (https://microsoft.github.io/vscode-codicons/dist/codicon.html)"
              },
              "group": {
                "type": "string",
                "description": "Group shown as a section in the view, e.g. Git or Build"
              },
              "confirm": {
                "type": "boolean",
                "description": "Ask before running the command"
              },
              "pinned": {
                "type": "boolean",
                "description": "Also show the button in the status bar"
              },
              "terminal": {
                "type": "string",
                "description": "Name of a terminal used only by this button, e.g. dev. Created when needed. Without it the command runs in the active terminal."
              },
              "inputs": {
                "type": "array",
                "description": "Questions for ${input:id} variables in the command. Without a definition, ${input:id} shows a text box.",
                "items": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[\\w-]+$",
                      "description": "Name used in ${input:id}"
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "promptString",
                        "pickString"
                      ],
                      "default": "promptString",
                      "enumDescriptions": [
                        "Text box",
                        "Pick one of the options"
                      ]
                    },
                    "description": {
                      "type": "string",
                      "description": "Shown as the question's title"
                    },
                    "default": {
                      "type": "string",
                      "description": "Value used before anything was entered; afterwards the last value is suggested"
                    },
                    "options": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "description": "Options for pickString"
                    },
                    "optionsFrom": {
                      "type": "string",
                      "description": "Shell command for pickString; each line of its output is an option, e.g. git branch --format=%(refname:short)"
                    },
                    "password": {
                      "type": "boolean",
                      "description": "Hide the typed value and do not remember it"
                    }
                  }
                }
              }
            }
          }
        },
        "terminalCommandButtons.layout": {
          "type": "string",
          "enum": [
            "icons",
            "list"
          ],
          "enumDescriptions": [
            "Compact icon buttons, name and command shown on hover",
            "One row per button with name and command"
          ],
          "default": "icons",
          "description": "How command buttons are displayed"
        },
        "terminalCommandButtons.windowsLeadingSpace": {
          "type": "boolean",
          "default": true,
          "description": "On Windows, prefix commands with a space. Works around a VS Code bug where Git Bash drops the first character of text sent to the terminal (microsoft/vscode#275625)."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "terminalCommandButtons.toggleCollapseAll",
          "when": "view == terminalCommandButtons.panelView || view == terminalCommandButtons.buttonsView",
          "group": "navigation@9"
        },
        {
          "command": "terminalCommandButtons.manageGitAliases",
          "when": "view == terminalCommandButtons.panelView || view == terminalCommandButtons.buttonsView",
          "group": "navigation@0"
        },
        {
          "command": "terminalCommandButtons.toggleLayout",
          "when": "view == terminalCommandButtons.panelView || view == terminalCommandButtons.buttonsView",
          "group": "navigation@1"
        },
        {
          "command": "terminalCommandButtons.dockToTerminal",
          "when": "view == terminalCommandButtons.panelView",
          "group": "navigation@2"
        },
        {
          "command": "terminalCommandButtons.runPicker",
          "when": "view == terminal",
          "group": "navigation"
        },
        {
          "command": "terminalCommandButtons.rerunLast",
          "when": "view == terminal && terminalCommandButtons.hasLast",
          "group": "navigation"
        }
      ],
      "terminal/context": [
        {
          "command": "terminalCommandButtons.runPicker",
          "group": "navigation@10"
        }
      ],
      "webview/context": [
        {
          "command": "terminalCommandButtons.runButton",
          "when": "webviewSection == 'terminalCommandButtons.button'",
          "group": "1_run@1"
        },
        {
          "command": "terminalCommandButtons.stopButton",
          "when": "webviewSection == 'terminalCommandButtons.button' && running",
          "group": "1_run@2"
        },
        {
          "command": "terminalCommandButtons.restartButton",
          "when": "webviewSection == 'terminalCommandButtons.button' && running",
          "group": "1_run@3"
        },
        {
          "command": "terminalCommandButtons.editButton",
          "when": "webviewSection == 'terminalCommandButtons.button'",
          "group": "2_edit@1"
        },
        {
          "command": "terminalCommandButtons.deleteButton",
          "when": "webviewSection == 'terminalCommandButtons.button'",
          "group": "2_edit@2"
        }
      ],
      "commandPalette": [
        {
          "command": "terminalCommandButtons.openButtonsPanel",
          "when": "true"
        },
        {
          "command": "terminalCommandButtons.addButton",
          "when": "true"
        },
        {
          "command": "terminalCommandButtons.dockToTerminal",
          "when": "true"
        },
        {
          "command": "terminalCommandButtons.rerunLast",
          "when": "terminalCommandButtons.hasLast"
        },
        {
          "command": "terminalCommandButtons.runButton",
          "when": "false"
        },
        {
          "command": "terminalCommandButtons.stopButton",
          "when": "false"
        },
        {
          "command": "terminalCommandButtons.restartButton",
          "when": "false"
        },
        {
          "command": "terminalCommandButtons.editButton",
          "when": "false"
        },
        {
          "command": "terminalCommandButtons.deleteButton",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.101.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.25.1",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "webpack": "^5.99.7",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.36"
  }
}
