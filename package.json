{
  "name": "terminal-command-buttons",
  "displayName": "Terminal Command Buttons",
  "description": "Add configurable command buttons to VS Code terminal",
  "version": "0.0.1",
  "publisher": "kacpermi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kacpermi/vscode-terminal-command-buttons.git"
  },
  "bugs": {
    "url": "https://github.com/kacpermi/vscode-terminal-command-buttons/issues"
  },
  "homepage": "https://github.com/kacpermi/vscode-terminal-command-buttons#readme",
  "keywords": [
    "terminal",
    "commands",
    "buttons",
    "productivity",
    "automation",
    "vscode-extension"
  ],
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "terminalCommandButtons.openButtonsPanel",
        "title": "Open Terminal Command Buttons",
        "category": "Terminal Command Buttons"
      },
      {
        "command": "terminalCommandButtons.addButton",
        "title": "Add New Command Button",
        "category": "Terminal Command Buttons"
      }
    ],
    "views": {
      "terminalCommandButtons": [
        {
          "type": "webview",
          "id": "terminalCommandButtons.buttonsView",
          "name": "Terminal Commands",
          "icon": "$(terminal)",
          "when": "true"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "terminalCommandButtons",
          "title": "Terminal Command Buttons",
          "icon": "$(terminal)"
        }
      ]
    },
    "configuration": {
      "title": "Terminal Command Buttons",
      "properties": {
        "terminalCommandButtons.buttons": {
          "type": "array",
          "default": [],
          "description": "List of custom command buttons",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique identifier for the button"
              },
              "name": {
                "type": "string",
                "description": "Display name for the button"
              },
              "command": {
                "type": "string",
                "description": "Command to execute"
              },
              "color": {
                "type": "string",
                "description": "Color for the button"
              }
            }
          }
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "terminalCommandButtons.openButtonsPanel",
          "when": "true"
        },
        {
          "command": "terminalCommandButtons.addButton",
          "when": "true"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.101.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3",
    "ts-loader": "^9.5.2",
    "webpack": "^5.99.7",
    "webpack-cli": "^6.0.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  }
}
